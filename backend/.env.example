# Banco de dados PostgreSQL
DATABASE_URL=postgresql://samgat_user:samgat2008%23@localhost:5432/samgat_store

# Servidor
PORT=5000
NODE_ENV=development

# Frontend
CORS_ORIGIN=http://localhost:5173

# JWT - Access Token
JWT_ACCESS_SECRET=seu-access-secret-mude-em-producao
JWT_ACCESS_EXPIRES_IN=15m

# JWT - Refresh Token
JWT_REFRESH_SECRET=seu-refresh-secret-mude-em-producao
JWT_REFRESH_EXPIRES_IN=7d

# Payments
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me

# Cloudinary
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=seu-api-secret
